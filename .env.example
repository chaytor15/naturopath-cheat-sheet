# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (Vercel + local API routes: email-registered check, booking, etc.)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (required for production email verify / OAuth redirects) ---
# Use your real browser origin, no trailing slash, e.g. https://your-app.vercel.app
# Vercel: Project → Settings → Environment Variables → Production (then redeploy).
# If this is wrong or localhost in Production, Supabase confirmation emails link to the wrong host.
# In Supabase → Auth → URL configuration, allow redirects: /auth/callback, /onboarding, /dashboard.
NEXT_PUBLIC_SITE_URL=

# Optional (Stripe etc.)
# NEXT_PUBLIC_APP_URL=
